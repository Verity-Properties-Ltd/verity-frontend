{
  "name": "verity-frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "node init && npm run dev --workspace=@verity/landing",
    "dev:app": "node init && npm run dev --workspace=@verity/app",
    "dev:public": "node init && npm run dev --workspace=@verity/public-page",
    "build:landing": "node init && npm run build --workspace=@verity/landing",
    "build:app": "node init && npm run build --workspace=@verity/app",
    "build:public": "node init && npm run build --workspace=@verity/public-page",
    "dev:storybook": "node init && npm run dev --workspace=@verity/storybook",
    "build:storybook": "node init && npm run build --workspace=@verity/storybook"
  }
}
