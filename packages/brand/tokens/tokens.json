{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Verity Design Tokens",
  "version": "1.0.0",
  "description": "Single source of truth for the Verity verification platform. Mirrors tokens/*.css.",
  "color": {
    "brand": {
      "navy":       { "value": "#1E2260", "role": "Anchor — primary brand, text, solid fills" },
      "navy-deep":  { "value": "#171A4A", "role": "Elevation — dark surfaces, toasts" },
      "navy-soft":  { "value": "#2C3078", "role": "Hover/active step on navy" },
      "cream":      { "value": "#F5F2ED", "role": "Ground — default page background" },
      "cream-shade":{ "value": "#EEEAE0", "role": "Surface — raised panels, fills" },
      "gold":       { "value": "#C9A961", "role": "Signal — one per surface only" },
      "gold-soft":  { "value": "#E0C994", "role": "Gold on dark grounds" },
      "gold-deep":  { "value": "#A88A45", "role": "Italic copy, gold text on light" },
      "slate":      { "value": "#6B6F77", "role": "Meta, secondary text" },
      "slate-soft": { "value": "#9DA1A8", "role": "Disabled, placeholder" },
      "white":      { "value": "#FFFFFF", "role": "Input fields, cards" }
    },
    "line": {
      "line":        { "value": "rgba(30,34,96,0.12)" },
      "line-strong": { "value": "rgba(30,34,96,0.22)" },
      "line-dark":   { "value": "rgba(245,242,237,0.14)" }
    },
    "semantic": {
      "success": { "value": "#3A7A5C" },
      "warning": { "value": "#B8862A" },
      "danger":  { "value": "#A8302A" },
      "info":    { "value": "#3C5A9C" }
    },
    "confidence-band": {
      "platinum":    { "value": "#1E2260", "treatment": "solid navy fill, gold dot, cream text" },
      "gold":        { "value": "#A88A45", "treatment": "gold tint" },
      "silver":      { "value": "#6B6F77", "treatment": "slate tint" },
      "bronze":      { "value": "#8A6F37", "treatment": "bronze tint" },
      "provisional": { "value": "#B8862A", "treatment": "amber tint" },
      "unconfirmed": { "value": "#9DA1A8", "treatment": "neutral outline" },
      "revoked":     { "value": "#A8302A", "treatment": "danger tint (state)" },
      "expired":     { "value": "#9DA1A8", "treatment": "muted 70% (state)" }
    }
  },
  "font": {
    "family": {
      "serif":   { "value": "'Cormorant Garamond', serif", "use": "Headings, body, tagline" },
      "mono":    { "value": "'DM Mono', monospace", "use": "Identifiers, meta, eyebrows, VPID/VPR" },
      "sans":    { "value": "'DM Sans', sans-serif", "use": "Rare UI utility" },
      "display": { "value": "'Tenor Sans', sans-serif", "use": "Wordmark ONLY — never body/UI" }
    },
    "size": {
      "display-1": "64px", "display-2": "48px",
      "h1": "36px", "h2": "28px", "h3": "22px", "h4": "18px",
      "body-lg": "18px", "body": "16px", "body-sm": "14px",
      "caption": "13px", "tagline": "20px",
      "mono-lg": "14px", "mono": "11px", "eyebrow": "10px"
    }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px"
  },
  "radius": {
    "0": "0", "1": "3px", "2": "6px", "3": "10px", "full": "999px",
    "_rule": "border-radius is capped at 10px on containers; pills use full. No radius on data cells."
  },
  "elevation": {
    "flat":     { "value": "none", "_rule": "default — shadows are banned except on overlays" },
    "raised":   { "value": "0 4px 14px -6px rgba(30,34,96,0.12)" },
    "floating": { "value": "0 14px 30px -16px rgba(30,34,96,0.18)", "use": "toasts" },
    "modal":    { "value": "0 30px 60px -24px rgba(30,34,96,0.30)", "use": "modal overlays only" }
  },
  "motion": {
    "duration": {
      "instant": "80ms", "fast": "150ms", "base": "200ms",
      "slow": "320ms", "deliberate": "480ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2,0.6,0.2,1)",
      "out": "cubic-bezier(0.16,1,0.3,1)",
      "in": "cubic-bezier(0.5,0,0.75,0)"
    }
  },
  "breakpoint": {
    "sm": "480px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px"
  }
}
